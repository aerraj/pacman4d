{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true
  },
  "include": ["main.tsx", "app/quantum-game.tsx", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
